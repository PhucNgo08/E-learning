# =========================
# APP
# =========================
APP_NAME=KHoaHocOnline
APP_ENV=development
DEBUG=true

# =========================
# DATABASE
# =========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=e_learning

DB_ECHO=false
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =========================
# SESSION / SECURITY
# =========================
SESSION_SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# =========================
# FILE / UPLOAD
# =========================
UPLOAD_DIR=backend/uploads

# =========================
# GOOGLE / AI
# =========================
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# MICROSOFT LOGIN
# =========================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# =========================
# WALLET / VIETQR
# =========================
VIETQR_BANK_ID=sacombank
VIETQR_BANK_NAME=Sacombank
VIETQR_ACCOUNT_NO=your_bank_account_no
VIETQR_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
VIETQR_TEMPLATE=compact2

MIN_TOPUP_AMOUNT=10000
MAX_TOPUP_AMOUNT=50000000

# =========================
# VNPAY SANDBOX
# =========================
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/student/cart/vnpay-return
VNPAY_IPN_URL=http://127.0.0.1:8000/student/cart/vnpay-ipn