# Copy to .env and fill with accounts that already exist in your MySQL database.
# Do NOT commit .env (it is gitignored).

BASE_URL=http://127.0.0.1:8000

# Admin (required for admin-menu tests)
ADMIN_IDENTIFIER=admin
ADMIN_PASSWORD=admin@123

# Teacher (required for teacher-menu tests)
TEACHER_IDENTIFIER=teacher1
TEACHER_PASSWORD=your_teacher_password

# Student (required for student-menu tests)
STUDENT_IDENTIFIER=student1
STUDENT_PASSWORD=your_student_password
