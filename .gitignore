# =====================================
# 🍀 PYTHON / FASTAPI BACKEND
# =====================================
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
.venv/

# IDE specific
.vscode/
.idea/

# Environment & secrets
.env
.env.local
*.env

# Logs
*.log
logs/
error.log

# Byte-compiled files
*.pyo
*.pyd
*.pdb

# MyPy / pytest / coverage
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# SQLite (nếu dùng)
*.sqlite3
*.db

# Compiled
build/
dist/

# =====================================
# 🖼 UPLOAD / MEDIA FILES
# Không đẩy ảnh/video/tài liệu lên GitHub
# =====================================
uploads/
media/
static/uploads/
static/avatars/
static/thumbnails/
static/materials/
static/videos/*
!static/videos/.gitkeep

# To avoid giant file push
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.rar
*.7z
*.iso
*.tar
*.gz

# =====================================
# ⚛️ REACT FRONTEND
# =====================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# Build output
frontend/react-app/build/
frontend/react-app/.cache/
frontend/react-app/dist/
*.map

# React local env
frontend/react-app/.env.local
frontend/react-app/.env.development.local
frontend/react-app/.env.test.local
frontend/react-app/.env.production.local

# =====================================
# 🌐 FRONTEND STATIC + EDITOR CONFIG
# =====================================
.DS_Store
Thumbs.db

# =====================================
# 🧩 GIT LFS / LARGE FILE SUPPORT
# =====================================
*.psd
*.ai
*.fig
*.blend

# =====================================
# ⚙️ OTHER IGNORES
# =====================================
*.bak
*.tmp
tmp/
cache/
