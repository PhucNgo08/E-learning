############################################################
#         KHoaHocOnline - E-Learning Platform 2025
#     AUTO-GENERATED .gitignore for FASTAPI + REACT
############################################################

############################
# PYTHON / FASTAPI
############################
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/
ENV/

# Build & Packaging
*.egg-info/
build/
dist/

# Temp directories
tmp/
temp/

############################
# BACKEND
############################

# Uploaded files (avatars, thumbnails, materials, assignments)
backend/uploads/
backend/app/uploads/
uploads/**
!uploads/**/.gitkeep

# Cache
backend/__pycache__/
backend/app/__pycache__/

# Logs
backend/logs/
*.log

# Environment variables
backend/.env
.env
.env.*

# Uvicorn PID, cache
*.pid
.cache/

############################
# ALEMBIC (Migration)
############################
backend/alembic/versions/*.pyc
backend/alembic/versions/*_temp.py
backend/alembic/versions/*_backup.py

############################
# DATABASE
############################
*.sql
*.bak
*.dump
*.backup

############################
# FRONTEND (REACT)
############################

# Node modules
frontend/react-app/node_modules/
frontend/react-app/.cache/
frontend/react-app/.vite/

# Build outputs
frontend/react-app/build/
frontend/react-app/dist/

# Environment files
frontend/react-app/.env
frontend/react-app/.env.local
frontend/react-app/.env.production
frontend/react-app/.env.development

# Extra OS files in frontend
frontend/react-app/.DS_Store

############################
# STATIC / AUTO-GENERATED
############################

# React → FastAPI copied builds
backend/app/static/
backend/static/

# Auto-generated CSS maps
frontend/react-app/layouts/styles/*.map

# General static builds
frontend/react-app/static/
static/

############################
# EDITOR / IDE
############################
.vscode/
.idea/
*.swp

############################
# OPERATING SYSTEM FILES
############################

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

############################
# COMPRESSED / EXPORTS
############################
*.zip
*.rar
*.7z

############################
# NOTEBOOKS
############################
*.ipynb_checkpoints/

############################
# BACKUPS
############################
backup/
backups/

############################################################
# END OF FILE
############################################################
