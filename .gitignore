############################################################
#         KHoaHocOnline - E-Learning Platform 2025
#     FULL .gitignore for FASTAPI + REACT (Team Ready)
############################################################

############################
# PYTHON / FASTAPI
############################
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
ENV/
.python-version

# Build & Packaging
*.egg-info/
build/
dist/
pip-wheel-metadata/
.wheels/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Type checker / IDE caches
.dmypy.json

############################
# BACKEND (FASTAPI)
############################

# Uploaded files (avatars, thumbnails, materials, assignments)
backend/uploads/
backend/app/uploads/
uploads/
uploads/**

# Keep folder structure if you use .gitkeep
!backend/uploads/.gitkeep
!backend/app/uploads/.gitkeep
!uploads/.gitkeep

# Cache
backend/__pycache__/
backend/app/__pycache__/

# Logs
backend/logs/
backend/app/config/logs/
*.log

# Environment variables / secrets
backend/.env
.env
.env.*
*.pem
*.key

# Uvicorn PID, cache
*.pid
.cache/

############################
# ALEMBIC (Migration)
############################
backend/alembic/versions/*.pyc
backend/alembic/versions/*_temp.py
backend/alembic/versions/*_backup.py

############################
# DATABASE / DUMPS
############################
*.sql
*.bak
*.dump
*.backup

############################
# FRONTEND (REACT)
############################

# Node modules (anywhere)
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/react-app/node_modules/

# Frontend caches
frontend/react-app/.cache/
frontend/react-app/.vite/
frontend/react-app/.eslintcache
frontend/react-app/.parcel-cache

# Build outputs
frontend/react-app/build/
frontend/react-app/dist/

# Environment files
frontend/react-app/.env
frontend/react-app/.env.*
frontend/react-app/.env.local
frontend/react-app/.env.production
frontend/react-app/.env.development

# OS junk in frontend
frontend/react-app/.DS_Store

############################
# STATIC / AUTO-GENERATED
############################

# React build copied to backend static (only ignore if generated)
backend/app/static/
backend/static/

# General static builds
static/

# Auto-generated CSS maps
frontend/react-app/layouts/styles/*.map

############################
# EDITOR / IDE
############################
.vscode/
.idea/
*.swp
*.swo

############################
# OPERATING SYSTEM FILES
############################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

############################
# COMPRESSED / EXPORTS
############################
*.zip
*.rar
*.7z

############################
# NOTEBOOKS
############################
.ipynb_checkpoints/

############################
# BACKUPS
############################
backup/
backups/

############################################################
# END OF FILE
############################################################
